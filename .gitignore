# Python
__pycache__/
*.pyc
.venv/
.ssh/

# Windows
*.lnk

# Ignore raw data
data/

# --- Regenerable derived artifacts (multi-MB to multi-GB) -------------------
# Every file below is fully reproducible from data/processed/*.parquet by
# re-running the documented pipeline stages.  They are excluded to keep the
# repository reviewable; see 00_setup.md -> "Regenerating excluded artifacts"
# for the exact commands.
archive/model1/results/dashboard.duckdb
archive/model1/results/*.duckdb

# Stage 7/8 per-row exports (GB-scale)
archive/model1/results/*test_scores.csv
archive/model1/results/*val_scores.csv
archive/model1/results/*test_probs.csv
archive/model1/results/*val_probs.csv
archive/model1/results/risk_tiers_test.csv
archive/model1/results/risk_tiers_val.csv
archive/model1/results/lstm_full_test_preds.csv
archive/model1/results/lstm_full_val_preds.csv

# Stage 11 SHAP matrices - intermediate, consumed by Stage 12, rebuildable
archive/model1/results/shap_values.parquet
archive/model1/results/shap_values_at_risk.parquet

# Stage 12 root-cause mapping - rebuildable from the two SHAP files above
archive/model1/results/mitigation_mapping.json

# --- Tracked on purpose -----------------------------------------------------
# archive/model1: models/*.json, lgbm_model.txt, hybrid_meta_model.pkl,
# results/*_metrics.csv, results/*_accuracy_*.csv, results/ablation_*.csv,
# results/baseline_comparison.csv, results/decision_quality.csv,
# results/shap/*.png
# These ARE the paper's evidence and must stay in version control.

# Ignore large model weights (if over GitHub's limit)
archive/model1/models/*.pt

# --- Superseded / scratch artifacts -----------------------------------------
# Quarantined stale exports kept for provenance. Multi-GB, never tracked.
archive/model1/results/*.STALE-*.csv
# Pre-rerun snapshots of the old model's metrics (kept locally as a record,
# reproducible via RUNBOOK.md, but they describe a model that no longer ships).
archive/model1/results_before_rerun/
archive/model1/results/backup_tier1/
# Ensemble accumulator checkpoints (large scratch, resumable not shareable)
archive/model1/results/_ens_ckpt_test/

# --- Amendment 03 fusion-partner study ---------------------------------------
# Per-row partner predictions (GB-scale), regenerable by 20_/22_/... scripts.
archive/model1/results_fusion/*_preds.csv
archive/model1/results_fusion/*.partial
archive/model1/results_fusion/_pb_confirm_*.parquet

# --- Identifier ablation (Amendments 01/02) ---------------------------------
# Per-row arm predictions and the joined bootstrap cache are GB-scale and
# regenerable (17_ablation_compare.py); each arm's lgbm_metrics.csv is tracked.
archive/model1/results_ablation/*/lgbm_*_probs.csv
archive/model1/results_ablation/_ablation_joined*
# Arm models (41 MB), regenerable with 06_train_lightgbm.py per the RUNBOOK.
archive/model1/models_ablation/

# Local pre-change snapshots, kept for provenance; each records its git commit.
snapshot_*/

# Agent evaluation: per-drive check table (3 MB), regenerable by 25_agent_eval.py policy
archive/model1/results/agent_eval/policy_checks.csv
archive/model1/results/agent_eval/policy_runs.jsonl

# --- Deployment of the retrained model (31_deploy_2026.py) -------------------
# Per-row 2026 scores, SHAP matrix, mapping and serving DB are GB-scale and
# rebuildable with `python 31_deploy_2026.py all`; the small metrics, cutoffs,
# and deployment.json are tracked.
results_deploy2026/_work/
results_deploy2026/*.duckdb
results_deploy2026/risk_tiers_test.csv
results_deploy2026/hybrid_test_scores.csv
results_deploy2026/shap_values_at_risk.parquet
results_deploy2026/mitigation_mapping.json
results_deploy2026/pa_urgency_test.csv

# Model 2 evaluation exports (GB-scale, rebuilt by 35_model2_eval.py export)
results_model2/_work/

# Survival-model validation predictions (reference fleet for urgency), regenerable
# with 37_urgency_model2.py predict
models/urgency/*_preds.csv
archive/model1/models/urgency/*_preds.csv
# Model 2 identifier-ablation arm models, regenerable with 36_model2_infra_ablation.py
models_model2_ablation/
